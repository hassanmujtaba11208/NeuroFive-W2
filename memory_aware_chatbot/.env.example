# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to GitHub.

# API key for any OpenAI-compatible provider (placeholder only)
OPENAI_API_KEY=your-api-key-here

# Base URL of the provider. Leave as-is for OpenAI.
# Examples: https://api.openai.com/v1  |  https://openrouter.ai/api/v1  |  https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model name for your provider
LLM_MODEL=gpt-4o-mini

# tiktoken encoding used for local token estimates
TOKEN_ENCODING=cl100k_base

# Context token budget (default 4000; the UI slider allows 500-16000)
TOKEN_BUDGET=4000

# Set to "true" to force offline demo mode (no API calls)
OFFLINE_MODE=false
